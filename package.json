{
  "name": "crystals-glass-store",
  "version": "1.3.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start -p 3100",
    "lint": "next lint",
    "test:storefront": "tsx --test scripts/gallery.test.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test:security": "tsx --test scripts/security.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "2.8.2",
    "bcryptjs": "^3.0.3",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.31",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.1": true,
    "prisma@5.22.0": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "postcss": "8.5.31",
    "zod": "4.6.7"
  }
}
