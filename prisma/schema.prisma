generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  price       Float
  cost        Float?
  description String
  images      String[] @default([])
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Event {
  id           String   @id @default(cuid())
  title        String
  date         DateTime
  platformLink String
  platformName String
  createdAt    DateTime @default(now())
}

model Admin {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String
}

// Generic key/value store for admin-editable site content:
// homepage hero, mission, About Crystal section, and social links.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Customer inquiries submitted from the "Inquire About This Piece" form.
model Inquiry {
  id          String   @id @default(cuid())
  productId   String?
  productName String
  name        String
  phone       String
  email       String
  message     String
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([phone])
  @@index([createdAt])
}

enum ContactCategory {
  NEW
  FOLLOWER
  BUYER
  B2B
}

// CRM contact record. Auto-created from inquiries (deduped by email) and
// manually addable by Crystal.
model Contact {
  id                String          @id @default(cuid())
  name              String
  phone             String
  email             String
  productOfInterest String?
  category          ContactCategory @default(NEW)
  notes             ContactNote[]
  createdAt         DateTime        @default(now())

  @@index([email])
  @@index([createdAt])
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}
